            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#645600"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "text-align": "center"
            },
            ".panel-title-edit, .mbr-iconfont": {
              "color": "#000000"
            }
          },
          "_name": "list01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1\" group=\"List\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\t\n    <mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<select title=\"Amount\" name=\"cardAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\" selected>6</option>\n\t\t</select>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Item\" name=\"items\" value=\"#e3d894\" selected>\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/lucid-origin_change_size_to_16_9-1344x768.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#fff2a5\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#a6a99c\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12 col-md-12 col-lg-10 m-auto\">\n\t\t\t\t<div class=\"content\">\n\t\t\t\t\t<div class=\"row justify-content-center mb-5\" mbr-if=\"showTitle || showSubtitle\">\n\t\t\t\t\t\t<div class=\"col-12 content-head\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-head\">\n\t\t\t\t\t\t\t\t<h1 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Q &amp; A- QUESTIONS &amp; ANSWERS</h1>\n\t\t\t\t\t\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mt-4 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\t\t\t\t\tFAQ</h5>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n\t\t\t\t\t\t<div class=\"card\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q1. ആർക്കൊക്കെ ഈ മത്സരത്തിൽ പങ്കെടുക്കാം?Who can participate?</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\t\t\tAns: പ്രായഭേദമന്യേ ആർക്കും ഈ മത്സരത്തിൽ പങ്കുചേരാവുന്നതാണ്. കലയെയും കവിതയെയും സ്നേഹിക്കുന്ന എല്ലാവരെയും ഞങ്ങൾ സ്വാഗതം ചെയ്യുന്നു.\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 1\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q2. ഒരു വ്യക്തിക്ക് ഒന്നിലധികം വീഡിയോകൾ അയക്കാമോ?Can I submit multiple entries?</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>Ans: അതെ. വ്യത്യസ്തമായ ആശയങ്ങളിലുള്ള ഒന്നിലധികം വീഡിയോകൾ നിങ്ങൾക്ക് സമർപ്പിക്കാവുന്നതാണ്.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 2\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q3.എങ്ങനെയുള്ള കണ്ടന്റുകളാണ് അയക്കേണ്ടത്?(What kind of content to submit?)</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Gj കവിതകളിലെ വരികളോ സംഗീതമോ പശ്ചാത്തലമാക്കി തയ്യാറാക്കുന്ന ഏത് സർഗ്ഗാത്മക സൃഷ്ടിയും നിങ്ങൾക്ക് സമർപ്പിക്കാം. പ്രധാനമായും താഴെ പറയുന്നവ ഉൾപ്പെടുത്താം:<br><br>നൃത്തം (Dance): കവിതയുടെ താളത്തിനൊത്തുള്ള ക്ലാസിക്കൽ, സിനിമാറ്റിക് അല്ലെങ്കിൽ ഫ്രീസ്റ്റൈൽ നൃത്തങ്ങൾ.<br><br>അഭിനയം / സ്കിറ്റുകൾ (Acting &amp; Skits): കവിതയിലെ വരികൾക്ക് ദൃശ്യാവിഷ്കാരം നൽകുന്ന ലഘുനാടകങ്ങൾ അല്ലെങ്കിൽ മോണോ ആക്ട്.<br><br>ലിപ് സിങ്ക് &amp; എക്സ്പ്രഷൻ (Lip-sync &amp; Expressions): വരികളുടെ അർത്ഥം ഉൾക്കൊണ്ടുകൊണ്ടുള്ള ഭാവപ്രകടനങ്ങൾ (Expressions).<br><br>സിനിമാറ്റിക് വിഷ്വൽസ് (Cinematic Visuals): കവിതയുടെ പശ്ചാത്തലത്തിൽ മനോഹരമായ പ്രകൃതിദൃശ്യങ്ങളോ മറ്റ് ദൃശ്യങ്ങളോ കോർത്തിണക്കിയുള്ള വീഡിയോകൾ.<br><br>പെയിന്റിംഗ് / കാലിഗ്രാഫി (Art &amp; Calligraphy): കവിത കേൾക്കുമ്പോൾ തത്സമയം വരയ്ക്കുന്ന ചിത്രങ്ങളോ വരികൾ മനോഹരമായി എഴുതുന്ന വീഡിയോകളോ.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 3\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q4.Can I submit other content? (മറ്റു കണ്ടന്റുകൾ സബ്മിറ്റ് ചെയ്യാമോ?)</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">പ്രത്യേകം ശ്രദ്ധിക്കാൻ:\n<br>പ്രമേയം (Theme): വീഡിയോ എന്തുതന്നെയായാലും അതിന്റെ അടിസ്ഥാനം Gj കവിതകൾ ആയിരിക്കണം.\n<br>\n<br>മൗലികത (Originality): നിങ്ങളുടെ സ്വന്തം ശൈലിയിലുള്ള അവതരണങ്ങൾക്ക് കൂടുതൽ മുൻഗണന ലഭിക്കും.\n<br>\n<br>നിലവാരം (Quality): വ്യക്തമായ ദൃശ്യങ്ങളും ശബ്ദവുമുള്ള വീഡിയോകൾ തിരഞ്ഞെടുക്കപ്പെടാൻ കൂടുതൽ സാധ്യതയുണ്ട്.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 4\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q5.Where should I upload my video?\n<div>(വീഡിയോകൾ എവിടെയാണ് അപ്‌ലോഡ് ചെയ്യേണ്ടത്?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>Ans: Upload it to your own YouTube or Instagram account and submit the link via our registration form.<br>(നിങ്ങളുടെ സ്വന്തം YouTube അല്ലെങ്കിൽ Instagram അക്കൗണ്ടിൽ അപ്‌ലോഡ് ചെയ്ത ശേഷം അതിന്റെ ലിങ്ക് ഞങ്ങളുടെ ഫോം വഴി സമർപ്പിക്കുക.)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 5\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q6. What are the prizes for the winners?<div>(വിജയികൾക്കുള്ള സമ്മാനങ്ങൾ എന്തൊക്കെയാണ്?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\t\t\tAns: Exciting cash prizes and certificates await the winners. Specific details will be announced soon on our website and social media.(<br>വിജയികളെ കാത്തിരിക്കുന്നത് ആകർഷകമായ പണക്കിഴികളും സർട്ടിഫിക്കറ്റുകളുമാണ്. കൂടുതൽ വിവരങ്ങൾ ഉടൻ തന്നെ വെബ്‌സൈറ്റിലൂടെയും സോഷ്യൽ മീഡിയയിലൂടെയും അറിയിക്കുന്നതാണ്.)\n\t\t\t\t\t\t\t\t\t</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_cid": "vjdSgGcesJ",
          "_anchor": "list01-22",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-iconfont": {
              "font-size": "1.2rem !important",
              "font-family": "'Moririse2' !important",
              "color": "white",
              "transition": "all 0.3s",
              "transform": "rotate(180deg)",
              "padding-left": "0.5rem"
            },
            ".panel-group": {
              "border": "none"
            },
            ".card-header": {
              "padding": "0rem",
              "@media (max-width: 767px)": {
                "padding": "0rem"
              }
            },
            ".panel-body": {
              "padding": "0rem",
              "padding-bottom": "0.5rem",
              "margin-top": "1rem"
            },
            ".img-col": {
              "padding": "0"
            },
            ".img-item": {
              "height": "100%"
            },
            "img": {
              "height": "100%",
              "object-fit": "cover"
            },
            ".collapsed": {
              "span": {
                "transform": "rotate(0deg)"
              }
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between"
            },
            "p": {
              "margin-bottom": "0.3rem"
            },
            ".panel-title-edit": {
              "color": "#000000"
            },
            ".card .card-header": {
              "background-color": "transparent",
              "margin-bottom": "0",
              "border": "0",
              "border-radius": "2rem"
            },
            ".card": {
              "background": "@items",
              "padding": "2.25rem",
              "margin-bottom": "1rem",
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "1rem"
              },
              "@media (min-width: 992px) and (max-width: 1200px)": {
                "margin-bottom": "1rem",
                "padding": "2rem 1.5rem"
              }
            },
            ".panel-text": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "text-align": "center"
            },
            ".panel-title-edit, .mbr-iconfont": {
              "color": "#000000"
            }
          },
          "_name": "list01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1\" group=\"List\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\t\n    <mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n\t\t<input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n\t\t<select title=\"Amount\" name=\"cardAmount\">\n\t\t\t<option value=\"1\">1</option>\n\t\t\t<option value=\"2\">2</option>\n\t\t\t<option value=\"3\">3</option>\n\t\t\t<option value=\"4\">4</option>\n\t\t\t<option value=\"5\">5</option>\n\t\t\t<option value=\"6\" selected>6</option>\n\t\t</select>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Item\" name=\"items\" value=\"#e3d894\" selected>\n\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/lucid-origin_change_size_to_16_9-1344x768.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#fff2a5\" selected>\n\t\t</fieldset>\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#a6a99c\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n\t<div class=\"container\">\n\t\t<div class=\"row justify-content-center\">\n\t\t\t<div class=\"col-12 col-md-12 col-lg-10 m-auto\">\n\t\t\t\t<div class=\"content\">\n\t\t\t\t\t<div class=\"row justify-content-center mb-5\" mbr-if=\"showTitle || showSubtitle\">\n\t\t\t\t\t\t<div class=\"col-12 content-head\">\n\t\t\t\t\t\t\t<div class=\"mbr-section-head\">\n\t\t\t\t\t\t\t\t<h4 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\"><b>Q &amp; A for Participants</b><br><b><br></b><div><b>(പങ്കെടുക്കുന്നവർക്കുള്ള ചോദ്യോത്തരങ്ങൾ)</b></div></h4>\n\t\t\t\t\t\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mt-4 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n\t\t\t\t\t\t\t\t\tFAQ</h5>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n\t\t\t\t\t\t<div class=\"card\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q7. When is the last date to submit the entry?<div>(വീഡിയോകൾ സമർപ്പിക്കേണ്ട അവസാന തീയതി എന്നാണ്?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Ans: The last date for submission is May 30, 2026. Make sure to register and submit your links before the deadline.<br>(എൻട്രികൾ സമർപ്പിക്കേണ്ട അവസാന തീയതി 2026 മെയ് 30 ആണ്. സമയപരിധിക്ക് മുൻപായി നിങ്ങളുടെ വീഡിയോ ലിങ്കുകൾ സമർപ്പിക്കാൻ ശ്രദ്ധിക്കുക.)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 1\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q8. Can we use any video editing apps?<div>(ഏത് വീഡിയോ എഡിറ്റിംഗ് ആപ്പുകളും ഉപയോഗിക്കാമോ?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Ans: Yes, you can use any editing software like CapCut, InShot, or Premiere Pro. However, make sure there are no watermarks from other apps (like TikTok).<br>(അതെ, നിങ്ങൾക്ക് ഇഷ്ടമുള്ള എഡിറ്റിംഗ് ആപ്പുകൾ ഉപയോഗിക്കാം. പക്ഷേ, മറ്റ് ആപ്പുകളുടെ വാട്ടർമാർക്കുകൾ വീഡിയോയിൽ ഉണ്ടാകാൻ പാടില്ല.)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 2\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q9. Is there any registration fee?(രജിസ്ട്രേഷൻ ഫീസ് ഉണ്ടോ?)</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">Ans: No, the registration is absolutely free! We encourage everyone to showcase their talent without any hurdles.<br>(ഇല്ല, രജിസ്ട്രേഷൻ പൂർണ്ണമായും സൗജന്യമാണ്! നിങ്ങളുടെ കഴിവുകൾ പ്രകടിപ്പിക്കാൻ എല്ലാവരെയും ഞങ്ങൾ സ്വാഗതം ചെയ്യുന്നു.)</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 3\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q10. How will the winners be selected?<div>(വിജയികളെ എങ്ങനെയാണ് തിരഞ്ഞെടുക്കുന്നത്?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">പ്രത്യേകം ശ്രദ്ധിക്കാൻ:\n<br>പ്രമേയം (Theme): വീഡിയോ എന്തുതന്നെയായാലും അതിന്റെ അടിസ്ഥാനം Gj കവിതകൾ ആയിരിക്കണം.\n<br>\n<br>മൗലികത (Originality): നിങ്ങളുടെ സ്വന്തം ശൈലിയിലുള്ള അവതരണങ്ങൾക്ക് കൂടുതൽ മുൻഗണന ലഭിക്കും.\n<br>\n<br>നിലവാരം (Quality): വ്യക്തമായ ദൃശ്യങ്ങളും ശബ്ദവുമുള്ള വീഡിയോകൾ തിരഞ്ഞെടുക്കപ്പെടാൻ കൂടുതൽ സാധ്യതയുണ്ട്.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 4\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q5. Where should I upload my video?.HASHTAGS&nbsp; എവിടെയാണ് നൽകേണ്ടത്?(വീഡിയോകൾ എവിടെയാണ് അപ്‌ലോഡ് ചെയ്യേണ്ടത്?)</h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\"><br>Ans: Upload it to your own YouTube or Instagram account and submit the link via our registration form.<br>നിങ്ങളുടെ സ്വന്തം YouTube അല്ലെങ്കിൽ Instagram അക്കൗണ്ടിൽ അപ്‌ലോഡ് ചെയ്ത ശേഷം അതിന്റെ ലിങ്ക് ഞങ്ങളുടെ ഫോം വഴി സമർപ്പിക്കുക.ഹാഷ്‌ടാഗുകൾ: ഓരോ വീഡിയോയിലും  ഹാഷ്‌ടാഗുകൾ ഉൾപ്പെടുത്തുക. ക്യാപ്ഷന്റെ (Caption) ഏറ്റവും അവസാന ഭാഗത്ത് ഹാഷ്‌ടാഗുകൾ നൽകുന്നതാണ് നല്ലത്.\n<br>വീഡിയോയുടെ മുകളിലും താഴെയും പ്രധാനപ്പെട്ട ടെക്സ്റ്റുകൾ നൽകാതിരിക്കാൻ ശ്രദ്ധിക്കുക അവിടെ പ്രൊഫൈൽ പേരും ക്യാപ്ഷനും വരുന്നത് കൊണ്ട് കാണാൻ ബുദ്ധിമുട്ടാകും.&nbsp;<br>HASHTAGS =&nbsp; &nbsp; &nbsp; &nbsp;#@iwiznet , #GjKavithakal, #MalayalamPoetry,#Kavithakal,#MalayalamLiterature,#മലയാളംകവിത,#കവിത,</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"card\" mbr-if=\"cardAmount > 5\">\n\t\t\t\t\t\t\t<div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n\t\t\t\t\t\t\t\t<a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n\t\t\t\t\t\t\t\t\t<h6 class=\"panel-title-edit mbr-semibold mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Q6. What are the prizes for the winners?<div>(വിജയികൾക്കുള്ള സമ്മാനങ്ങൾ എന്തൊക്കെയാണ്?)</div></h6>\n\t\t\t\t\t\t\t\t\t<span class=\"sign mbr-iconfont mobi-mbri-arrow-down\"></span>\n\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n\t\t\t\t\t\t\t\t<div class=\"panel-body\">\n\t\t\t\t\t\t\t\t\t<p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-text\">\n\t\t\t\t\t\t\t\t\t\tAns: Exciting cash prizes and certificates await the winners. Specific details will be announced soon on our website and social media.<br>വിജയികളെ കാത്തിരിക്കുന്നത് ആകർഷകമായ പണക്കിഴികളും സർട്ടിഫിക്കറ്റുകളുമാണ്. കൂടുതൽ വിവരങ്ങൾ ഉടൻ തന്നെ വെബ്‌സൈറ്റിലൂടെയും സോഷ്യൽ മീഡിയയിലൂടെയും അറിയിക്കുന്നതാണ്.</p>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
          "_anchor": "list01-23",
          "_cid": "vjdXHab7nG",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = \"video\")": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "overflow": "hidden",
              "background": "@rowColor"
            },
            ".text-wrapper": {
              "padding": "4rem 3rem",
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2.25rem"
              },
              "@media (max-width: 767px)": {
                "padding": "1.5rem"
              }
            },
            ".row": {
              "align-items": "center",
              "margin-right": "-1rem",
              "margin-left": "-1rem"
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".image-wrapper": {
              "padding": "0 1rem"
            },
            "img, .image-wrapper": {
              "height": "(@imageHeight * 100px)",
              "object-fit": "cover",
              "@media (max-width: 767px)": {
                "max-height": "350px"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#000000"
            },
            ".price": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_name": "features025",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features025\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n    <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n    <header>Image</header>\n    <input type=\"range\" inline title=\"Height\" name=\"imageHeight\" min=\"4\" max=\"12\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline name=\"imageWidth\" title=\"Width\" min=\"4\" max=\"8\" step=\"1\" value=\"4\">\n    <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n    <header>Show/Hide</header>\n    <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n    <input type=\"checkbox\" title=\"Price\" name=\"showPrice\" checked>\n    <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n    <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n    <header>Color</header>\n    <input type=\"color\" title=\"Color\" name=\"rowColor\" value=\"#e3d894\" selected>\n    <header>Background</header>\n    <fieldset type=\"background\" name=\"bg\" parallax>\n      <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/gemini_generated_image_c4jis9c4jis9c4ji-2000x2000.png\">\n      <input type=\"color\" title=\"Color\" value=\"#e3d894\" selected>\n      <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n    </fieldset>\n    <header condition=\"bg.type === 'video'\">Fallback Image</header>\n    <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/features025/../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n  </mbr-parameters>\n\n  <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n  <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n  <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n    <div class=\"row justify-content-center align-items-center\">\n      <div class=\"col-12\">\n        <div class=\"card-wrapper\">\n          <div class=\"row\">\n            <div class=\"col-12 col-md-12 col-lg-{{imageWidth}} image-wrapper\">\n              <a href=\"https://www.youtube.com/playlist?list=PL_yLGhCr5gTn4V5i6QJtc5T_5OQgrfSGk\" target=\"_blank\"><img class=\"w-100\" src=\"@PROJECT_PATH@/assets/images/image20-202026-05-28t213420.431-815x815.jpg\" alt=\"Mobirise Website Builder\"></a>\n            </div>\n            <div class=\"col-12 col-lg col-md-12\">\n              <div class=\"text-wrapper align-left\">\n                <h5 class=\"mbr-section-title mbr-fonts-style mb-4\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\"><b>&nbsp; &nbsp; &nbsp; Gj കവിതകൾ</b></h5>\n                <p class=\"price mbr-fonts-style mb-4\" mbr-theme-style=\"display-5\" mbr-if=\"showPrice\" data-app-selector=\".price\">iWizNet Future Artificial Intelligence community (\"iFAi\")<br><br>ആമുഖം<br>\n                </p>\n                <p class=\"mbr-text mbr-fonts-style mb-4\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\"><b><i><br>&nbsp;എന്ന ഈ ആഗോള കൂട്ടായ്മയിലൂടെ നാം ലക്ഷ്യമിടുന്നത് കലയെയും കവിതയെയും സാമൂഹിക മാറ്റത്തിനുള്ള ശക്തമായ ആയുധമാക്കി മാറ്റാനാണ്. മാനവികതയും കരുണയും മുഖമുദ്രയാക്കിയ ഈ വേദിക്കു കീഴിൽ പാർശ്വവൽക്കരിക്കപ്പെട്ടവരുടെ ശബ്ദം ലോകമെങ്ങും പ്രതിധ്വനിക്കും.<br><br>ഈ പ്ലാറ്റ്‌ഫോമിലൂടെ പുറത്തിറങ്ങുന്ന Gj കവിതാ സമാഹാരം, ചുറ്റുമുള്ള ലോകത്തെ കൂടുതൽ കാരുണ്യത്തോടെ നോക്കിക്കാണാൻ നമ്മെ പ്രേരിപ്പിക്കുന്നു. സ്നേഹത്തിന്റെയും നീതിയുടെയും പുതിയൊരു സംസ്കാരം കെട്ടിപ്പടുക്കാനുള്ള ഈ യാത്രയിൽ നിങ്ങൾ ഓരോരുത്തരെയും ഞങ്ങൾ സ്വാഗതം ചെയ്യുന്നു.<br><br>ശാന്തമായ പ്രകൃതിവർണ്ണനകൾ മുതൽ അതിശക്തമായ പ്രതിഷേധ സ്വരങ്ങൾ വരെ ഈ ആൽബത്തിൽ അണിനിരക്കുന്നു. ആധുനിക സംഗീതത്തിന്റെ അകമ്പടിയോടെ അവതരിപ്പിക്കപ്പെടുന്ന ഈ വരികൾ ഓരോ ശ്രോതാവിനെയും ചിന്തിപ്പിക്കുകയും സ്വപ്നം കാണാൻ പ്രേരിപ്പിക്കുകയും ചെയ്യും.<br><br>ഓരോ ആഴ്ചയും വൈവിധ്യമാർന്ന പുതിയ വീഡിയോ ഗാനങ്ങൾ <a href=\"https://www.youtube.com/playlist?list=PL_yLGhCr5gTn4V5i6QJtc5T_5OQgrfSGk\" class=\"text-black\" target=\"_blank\">@iwiznet</a> <br>എന്ന ഞങ്ങളുടെ ഔദ്യോഗിക യൂട്യൂബ് ചാനലിലൂടെ നിങ്ങളുടെ മുന്നിലെത്തുന്നു<br>പുതിയ വിശേഷങ്ങൾ അറിയാൻ!<br>സംഗീതവും കവിതയും ഇഴചേരുന്ന ഈ പുത്തൻ സൃഷ്ടികൾ ആസ്വദിക്കാൻ ഞങ്ങളുടെ ചാനൽ സന്ദർശിക്കുമല്ലോ.<br>നിലവിൽ അപ്‌ലോഡ് ചെയ്തിട്ടുള്ള എല്ലാ വീഡിയോ സോങ്‌സും <br> കാണുന്നതിനായി താഴെയുള്ള 'Playlists' എന്ന ബട്ടൺ അമർത്തുക.</i></b><br>\n                </p>\n                <div mbr-buttons mbr-theme-style=\"display-2\" class=\"mbr-section-btn mt-3\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-lg btn-primary\" href=\"https://www.youtube.com/playlist?list=PL_yLGhCr5gTn4V5i6QJtc5T_5OQgrfSGk\" data-app-placeholder=\"Type Text\" target=\"_blank\">&nbsp;YouTube Playlist</a></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "vjuXZQS3fD",
          "_anchor": "features025-4h",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".footer-col": {
              "justify-content": "space-between",
              "display": "flex",
              "@media (max-width: 767px)": {
                "flex-direction": "column"
              }
            },
            ".row": {
              "background": "@row",
              "padding": "4rem 3rem",
              "border-radius": "2rem",
              "margin": "0",
              "@media (max-width: 767px)": {
                "padding": "2rem 0.5rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2.25rem 1.25rem"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem 3rem"
              }
            },
            ".mbr-section-btn": {
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".social-row": {
              "display": "flex",
              "flex-wrap": "wrap"
            },
            ".soc-item": {
              "margin": "8px",
              "a": {
                "&:hover, &:focus": {
                  ".mbr-iconfont": {
                    "background-color": "@active"
                  }
                },
                ".mbr-iconfont": {
                  "width": "72px",
                  "height": "72px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "100%",
                  "font-size": "20px",
                  "background-color": "@iconBg",
                  "color": "@icon",
                  "transition": "all 0.3s ease-in-out"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".row": {
                "text-align": "center"
              },
              ".social-row": {
                "justify-content": "center"
              }
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0rem"
              },
              "color": "#502274"
            },
            ".mbr-text": {
              "color": "#bbbbbb"
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "text-align": "left"
            },
            ".list, .item-wrap": {
              "color": "#232323",
              "text-align": "justify"
            },
            ".copyright": {
              "color": "#000000"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" global once=\"footers\" mbr-class=\"{\n    'mbr-parallax-background': bg.parallax}\">\n\t<mbr-parameters>\n\t\t<header>Size</header>\n\t\t<input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n\t\t<input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n\t\t<input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n\t\t<input type=\"color\" title=\"Color\" value=\"#2e481a\" name=\"icon\" condition=\"showSocial\">\n\t\t<input type=\"color\" title=\"Active Color\" value=\"#e3d894\" condition=\"showSocial\" name=\"active\">\n\t\t<input type=\"color\" title=\"BG\" value=\"#f82d51\" name=\"iconBg\" condition=\"showSocial\">\n\n\t\t<input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showSocial\">\n\t\t<input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n\t\t<header>Color</header>\n\t\t<input type=\"color\" title=\"Container\" name=\"row\" value=\"#faf9cf\">\n\t\t<header>Background</header>\n\t\t<fieldset type=\"background\" name=\"bg\" parallax>\n\t\t\t<input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n\t\t\t<input type=\"color\" title=\"Color\" value=\"#faf9cf\" selected>\n\t\t\t<input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n\t\t</fieldset>\n\t\t<header condition=\"bg.type === 'video'\">Fallback Image</header>\n\t\t<input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n\t\t<input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n\t\t<input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#474547\" condition=\"overlay && bg.type !== 'color'\">\n\t\t<input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n\t</mbr-parameters>\n\n\t<div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n\t<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\t<div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n\t\t<div class=\"row mbr-white\">\n\t\t\t<div class=\"col-12 col-md-6 col-lg-3\">\n\t\t\t\t<h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>&nbsp;English</b></h5>\n\t\t\t\t<ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n\t\t\t\t\t<li class=\"mbr-text item-wrap\"><b>•\tSlaves Of Death</b></li><li class=\"mbr-text item-wrap\"><b>•\tCan’t You Hear The Screams</b></li><li class=\"mbr-text item-wrap\"><b>•\tSilence Is Not Consent!</b></li><li class=\"mbr-text item-wrap\"><b>•\tTaboos And Prohibitions</b></li><li class=\"mbr-text item-wrap\"><b>•\tZombie Song English Part 1</b></li><li class=\"mbr-text item-wrap\"><b>•\tZombie Song English Part 2</b></li><li class=\"mbr-text item-wrap\"><b>• Enjoy Your Freedom</b></li><li class=\"mbr-text item-wrap\"><b>• Taboos and Prohibitions</b></li><li class=\"mbr-text item-wrap\"><b>• Tunnel Vision</b></li><li class=\"mbr-text item-wrap\"><b>• Bermuda Triangle</b></li><li class=\"mbr-text item-wrap\"><b>• Unheard Melodies of Death!</b></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-md-6 col-lg-3\">\n\t\t\t\t<h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>&nbsp;Malayalam</b></h5>\n\t\t\t\t<ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n\t\t\t\t\t<li class=\"mbr-text item-wrap\"><b>•\tകുട്ടിപ്പാട്ട്!</b></li><li class=\"mbr-text item-wrap\"><b>•\tസോമ്പി സോങ്!</b></li><li class=\"mbr-text item-wrap\"><b>•മരണത്തിന്റെ നിഴലുകൾ!</b></li><li class=\"mbr-text item-wrap\"><b>•\tജീവനിൽ ഭയം!</b></li><li class=\"mbr-text item-wrap\"><b>•\tബർമുഡ ട്രയാങ്കിൾ!</b></li><li class=\"mbr-text item-wrap\"><b>•\tസ്വപ്നം പോലെ !</b></li><li class=\"mbr-text item-wrap\"><b>•\t ടണൽ വിഷൻ!</b></li><li class=\"mbr-text item-wrap\"><b>•\tവിലക്കുകൾ!</b></li><li class=\"mbr-text item-wrap\"><b>•\tകുഞ്ഞേ പിറക്കരുതേ!</b></li><li class=\"mbr-text item-wrap\"><b>•അരികിലായിരുന്നെങ്കിലും!</b></li><li class=\"mbr-text item-wrap\"><br></li><li class=\"mbr-text item-wrap\"><br></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-md-6 col-lg-3\">\n\t\t\t\t<h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style mb-2\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>&nbsp;Malayalam</b></h5>\n\t\t\t\t<ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n\t\t\t\t\t<li class=\"mbr-text item-wrap\"><b>. സവർണ്ണസൂര്യൻ!&nbsp;</b></li><li class=\"mbr-text item-wrap\"><b>.&nbsp; ചരമഗീതം</b></li><li class=\"mbr-text item-wrap\"><b>. മൗനം സമ്മതമല്ല!</b></li><li class=\"mbr-text item-wrap\"><b>. ലോകരക്ഷകൻ!</b></li><li class=\"mbr-text item-wrap\"><b>. അടിമകൾ!</b></li><li class=\"mbr-text item-wrap\"><b>. പൊറുക്കുക!</b></li><li class=\"mbr-text item-wrap\"><b>• ഫ്രീഡം സോങ്!</b></li><li class=\"mbr-text item-wrap\"><b>• സുഖമുള്ളൊരിടിമഴയായ്!</b></li><li class=\"mbr-text item-wrap\"><b>• ഇരകൾ!</b></li><li class=\"mbr-text item-wrap\"><b>• നീയെടുക്കുന്നവാളുകൾ!</b></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 col-md-6 col-lg-3\">\n\t\t\t\t<h5 class=\"mbr-section-subtitle mbr-fonts-style mb-2\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-subtitle\"><b>Released</b></h5>\n\t\t\t\t<ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n\t\t\t\t\t<li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/BQlpErgw4oo?si=3grDR24FSkYRH_a_\" class=\"text-primary\" target=\"_blank\">മാഡ്മാൻ Malayalam Part1</a>\n</li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/ERxVHwMeRFI?si=1EyEe_0XIdyq24uS\" class=\"text-primary\" target=\"_blank\">മാഡ്മാൻ Malayalam Part2</a>\n</li><li class=\"mbr-text item-wrap\"><a href=\"https://youtu.be/QBT0R1JYoos?si=B6W9aXOBVtAbbNhW\" class=\"text-primary\" target=\"_blank\">•\tമാഡ്മാൻ Malayalam Part3</a>\n</li><li class=\"mbr-text item-wrap\">•<a href=\"https://youtu.be/2t3aub6ciGo?si=16yn8Ub82j4jK42X\" class=\"text-primary\" target=\"_blank\">\tMad Man_The God Puppet Master Part1</a>\n</li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/wN0o64K7cws?si=dM6B4g3vkY6LRhF_\" class=\"text-primary\" target=\"_blank\">Mad Man_The God Puppet Master Part2</a>\n</li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/H_jXoCIkxY0?si=CLnH995NU3PxPBUr\" class=\"text-primary\" target=\"_blank\">Mad Man_The God Puppet Master Part3</a>\n</li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/W-rJ2YpffmM?si=ZWi9JG-UiyR6IRT4\" class=\"text-primary\" target=\"_blank\">നിലവിളികൾ കേൾക്കുന്നില്ലേ</a>\n</li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://youtu.be/pqoE1oFndQc?si=cbZTXBXOPaEsaCP9\" class=\"text-primary\" target=\"_blank\">ജീവന്റെ വിലയുള്ള വാക്കുകൾ</a>\n</li><li class=\"mbr-text item-wrap\">•<a href=\"https://youtu.be/K9FUwMcZdNY?si=28zF7Ynj8VEOZh-S\" class=\"text-primary\" target=\"_blank\">\tജീവന്റെവിലയുള്ളവാക്കുകൾ Shorts</a></li><li class=\"mbr-text item-wrap\">•\t<a href=\"https://push.fm/fl/ndcldren\" class=\"text-primary\" target=\"_blank\">അരാവല്ലിയുടെ കണ്ണുനീർ</a>\n</li><li class=\"mbr-text item-wrap\"><br></li>\n\t\t\t\t</ul>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 mt-5 footer-col\" mbr-if=\"showSocial || showButtons\">\n\t\t\t\t<div mbr-buttons mbr-if=\"showButtons\" mbr-theme-style=\"display-5\" class=\"mbr-section-btn align-left\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"https://www.youtube.com/playlist?list=PL_yLGhCr5gTn4V5i6QJtc5T_5OQgrfSGk\" data-app-placeholder=\"Type Text\" target=\"_blank\">YouTube Playlist</a>\n\t\t\t\t\t<a class=\"btn btn-primary\" href=\"https://push.fm/fl/ndcldren\" data-app-placeholder=\"Type Text\" target=\"_blank\">Releases Playlist</a></div>\n\n\t\t\t\t<div class=\"social-row mt-2 display-7\" mbr-if=\"showSocial\">\n\t\t\t\t\t<div class=\"soc-item\">\n\t\t\t\t\t\t<a href=\"https://mobiri.se/\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon socicon-facebook\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>1\">\n\t\t\t\t\t\t<a href=\"https://mobiri.se/\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon socicon-twitter\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>2\">\n\t\t\t\t\t\t<a href=\"https://mobiri.se/\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon socicon-instagram\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div class=\"soc-item\" mbr-if=\"socialCount>3\">\n\t\t\t\t\t\t<a href=\"https://mobiri.se/\">\n\t\t\t\t\t\t\t<span mbr-icon class=\"mbr-iconfont socicon-logmein socicon\"></span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-12 mt-4\" mbr-if=\"showCopyright\">\n\t\t\t\t<p class=\"mbr-text mb-0 mbr-fonts-style copyright align-center\" mbr-theme-style=\"display-5\" data-app-selector=\".copyright\" data-app-placeholder=\"Type Text\">\n\t\t\t\t\t© Copyright 2026 www.iWizNet.in- All Rights Reserved\n\t\t\t\t</p>\n\t\t\t</div>\n\t\t</div>\n\t</div>\n</section>",
