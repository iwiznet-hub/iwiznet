              "color": "#000000"
            },
            ".card-box": {
              "display": "flex",
              "flex-direction": "column",
              "height": "100%",
              ".item-footer": {
                "margin-top": "auto"
              }
            },
            ".content-head": {
              "max-width": "800px"
            },
            ".card-title, .iconfont-wrapper": {
              "color": "#232323"
            },
            ".card-text, .item .mbr-section-btn": {
              "color": "#2e481a",
              "text-align": "center"
            },
